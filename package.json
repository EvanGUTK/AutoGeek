{
  "name": "autogeek",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.9.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:eslint && pnpm lint:format && pnpm lint:deps",
    "lint:eslint": "eslint --config eslint.config.js . --max-warnings 0",
    "lint:format": "prettier --check .",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs apps packages tooling",
    "format": "prettier --write .",
    "test": "turbo run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
