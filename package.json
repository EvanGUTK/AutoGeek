{
  "name": "autogeek",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.9.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:eslint && pnpm lint:format && pnpm lint:deps",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:format": "prettier --check .",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs apps packages tooling",
    "format": "prettier --write .",
    "test": "turbo run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "catalog:",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
